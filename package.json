{
  "name": "naxas-mcp",
  "version": "0.5.1",
  "description": "Secure self-hosted PostgreSQL MCP gateway with read-only defaults, controlled writes, audit logging, and Docker/Coolify support.",
  "type": "module",
  "license": "MIT",
  "author": "Ainul Islam",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "naxas-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "sql",
    ".env.example",
    "Dockerfile",
    "docker-compose.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aimzworld007/Naxas-MCP-Server.git"
  },
  "homepage": "https://github.com/aimzworld007/Naxas-MCP-Server#readme",
  "bugs": {
    "url": "https://github.com/aimzworld007/Naxas-MCP-Server/issues"
  },
  "keywords": [
    "mcp",
    "postgresql",
    "postgres",
    "ai",
    "chatgpt",
    "database",
    "gateway",
    "self-hosted",
    "coolify",
    "docker"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && node dist/cli.js --help",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.11",
    "express-rate-limit": "^8.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
