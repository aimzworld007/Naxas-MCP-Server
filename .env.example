PORT=3000
MCP_BEARER_TOKEN=replace-with-a-long-random-secret
MCP_ALLOWED_HOSTS=mcp.naxasit.com,localhost,127.0.0.1
NAXAS_DB_READ_URL=postgresql://naxas_readonly:password@postgres:5432/naxas
