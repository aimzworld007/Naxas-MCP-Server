PORT=3000
MCP_BEARER_TOKEN=replace-with-a-long-random-secret-at-least-32-characters
# Optional: per-user SHA-256 token hashes and project allowlists. See docs/MULTI_USER_VSCODE.md.
MCP_USERS_JSON={}
# Persistent volume required for access changes through the admin dashboard.
MCP_ACCESS_FILE=/app/data/access.json
MCP_ALLOWED_HOSTS=mcp.example.com,localhost,127.0.0.1

# Server-side allowlist. Never accept database URLs from tool-call input.
# Safe default: configure READ ONLY first. Add writeUrl + writeEnabled=true only after
# read-only verification is complete and the writer role has been explicitly restricted.
PROJECTS_JSON={"01":{"name":"Naxas Inventory","readUrl":"postgresql://naxas_readonly:password@postgres:5432/naxas"}}

DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
MCP_RATE_LIMIT_WINDOW_MS=60000
MCP_RATE_LIMIT_MAX=60
DEFAULT_MAX_WRITE_ROWS=100
AUDIT_LOG_ENABLED=true
